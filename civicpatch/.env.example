GOOGLE_SEARCH_TOKEN=<https://developers.google.com/custom-search/v1/overview>
GOOGLE_SEARCH_ENGINE_ID=<https://developers.google.com/custom-search/v1/overview>
SERP_API_SEARCH_TOKEN=<https://serpapi.com/>
BRAVE_SEARCH_TOKEN=<https://brave.com/search/api/>

GOOGLE_GEMINI_TOKEN=<https://ai.google.dev/gemini-api/docs/api-key>
OPENAI_TOKEN=<https://openai.com/api/>
