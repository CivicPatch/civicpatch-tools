# The following needs coordination with michelle@civicpatch.org
CRUDDER_SHARED_TOKEN=
CRUDDER_URL="https://crudder.civicpatch.org"

# THIS WILL (MAY) BE DIFFERENT FOR EVERY ENVIRONMENT 
# double check with echo $UID and echo $GID on your host machine
UID=1000
GID=1000

LOG_LEVEL=INFO
# Log levels are as follows:
# DEBUG - includes all logs 
# INFO - includes INFO, WARNING, ERROR
# WARNING - you should not manually set this
# ERROR - you should not manually set this

#################################################
# OPTIONAL: this is only run under the github actions pipeline
#################################################

